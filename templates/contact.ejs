<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Contact — Home Donation</title>
    <style>
    :root{
      --bg:#071028;
      --card:#0b1220;
      --muted:#9aa7b2;
      --accent:#7c3aed;
      --accent-2:#06b6d4;
      --white:#f8fafc;
      --radius:12px;
      --glass: rgba(255,255,255,0.03);
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
      background: linear-gradient(180deg, #071028 0%, #071a2a 60%);
      color:var(--white);
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      line-height:1.45;
    }
    .nav{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:1rem;
      padding:1rem 1.25rem;
      max-width:1100px;
      margin:0 auto;
    }
    .brand{
      display:flex;
      align-items:center;
      gap:.75rem;
      text-decoration:none;
      color:var(--white);
    }
    .logo{
      width:44px;
      height:44px;
      border-radius:10px;
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      display:inline-grid;
      place-items:center;
      font-weight:700;
      box-shadow:0 6px 18px rgba(124,58,237,0.18);
    }
    .brand h1{font-size:1rem;margin:0;font-weight:700;letter-spacing:0.2px}
    .nav-links{
      display:flex;
      gap:1rem;
      align-items:center;
    }
    .nav-links a{
      color:var(--muted);
      text-decoration:none;
      padding:.45rem .6rem;
      border-radius:8px;
      font-weight:600;
      font-size:.95rem;
    }
    .nav-links a:hover{color:var(--white); background:var(--glass)}
    .btn-donate{
      background:linear-gradient(90deg,var(--accent),var(--accent-2));
      color:var(--white);
      padding:.6rem .9rem;
      border-radius:10px;
      border:0;
      font-weight:700;
      cursor:pointer;
      box-shadow:0 8px 24px rgba(6,182,212,0.12);
    }
    .container{
      max-width:1100px;
      margin:2.25rem auto;
      padding:1.25rem;
    }
    .grid{
      display:grid;
      grid-template-columns:1fr 420px;
      gap:1.5rem;
      align-items:start;
    }
    .card{
      background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
      border-radius:var(--radius);
      padding:1.5rem;
      box-shadow:0 10px 30px rgba(2,6,23,0.6);
      border:1px solid rgba(255,255,255,0.03);
    }
    h2{margin:0 0 .5rem 0; font-size:1.6rem; color:var(--white)}
    p.lead{color:var(--muted); margin:0 0 1rem 0; font-size:1rem}
    form{display:flex;flex-direction:column;gap:.9rem}
    label{font-weight:600;color:var(--muted);font-size:.9rem}
    input[type="text"], input[type="email"], textarea{
      width:100%;
      padding:.75rem;
      border-radius:10px;
      border:1px solid rgba(255,255,255,0.04);
      background:transparent;
      color:var(--white);
      font-weight:600;
      font-size:.95rem;
    }
    textarea{min-height:140px;resize:vertical;padding-top:.8rem}
    .row{display:flex;gap:.75rem}
    .row .col{flex:1}
    .form-actions{display:flex;gap:.75rem;align-items:center;margin-top:.5rem}
    .btn-primary{
      background:linear-gradient(90deg,var(--accent),var(--accent-2));
      color:var(--white);
      padding:.7rem 1rem;
      border-radius:10px;
      border:0;
      font-weight:700;
      cursor:pointer;
    }
    .btn-ghost{
      background:transparent;
      color:var(--muted);
      border:1px solid rgba(255,255,255,0.04);
      padding:.6rem .9rem;
      border-radius:10px;
      cursor:pointer;
      font-weight:600;
    }
    .contact-info h3{margin:0 0 .25rem 0;color:var(--accent)}
    .info-list{color:var(--muted);margin:0;padding:0;list-style:none}
    .info-list li{margin:.6rem 0;display:flex;gap:.6rem;align-items:center}
    .chip{display:inline-grid;place-items:center;width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,0.02);color:var(--white);font-weight:700}
    .map{
      margin-top:1rem;
      height:180px;
      border-radius:10px;
      background:linear-gradient(180deg, rgba(6,182,212,0.06), rgba(124,58,237,0.04));
      display:flex;
      align-items:center;
      justify-content:center;
      color:var(--white);
      font-weight:700;
      border:1px solid rgba(255,255,255,0.03);
    }
    footer{
      margin-top:2rem;
      padding:1.25rem;
      text-align:center;
      color:var(--muted);
      font-size:.9rem;
    }
    @media (max-width:880px){
      .grid{grid-template-columns:1fr}
      .nav-links{display:none}
    }
  </style>
</head>
<body>
  <header class="nav" role="banner">
    <a class="brand" href="#" aria-label="Home">
      <div class="logo">HD</div>
      <div>
        <h1>Home Donation</h1>
        <div style="font-size:.78rem;color:var(--muted);margin-top:2px">Give with purpose</div>
      </div>
    </a>

    <nav class="nav-links" role="navigation" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <button class="btn-donate" aria-label="Donate now">Donate</button>
    </nav>
  </header>

  <main class="container" role="main">
    <section aria-labelledby="contact-title">
      <h2 id="contact-title">Get in touch</h2>
      <p class="lead">We'd love to hear from you. Whether you have questions about donations, volunteering, or partnerships, reach out and we'll respond as soon as possible.</p>

      <div class="grid" role="region" aria-label="Contact grid">
       <div class="card" aria-labelledby="form-title">
          <h3 id="form-title" style="margin:0 0 .5rem 0;color:var(--white)">Contact form</h3>
          <p style="color:var(--muted);margin:0 0 1rem 0">Fill out the form below and we'll get back to you within 2 business days.</p>

          <form id="contactForm" novalidate>
            <div class="row">
              <div class="col">
                <label for="name">Full name</label>
                <input id="name" name="name" type="text" placeholder="Your full name" required aria-required="true">
              </div>
              <div class="col">
                <label for="email">Email address</label>
                <input id="email" name="email" type="email" placeholder="you@example.com" required aria-required="true">
              </div>
            </div>

            <div>
              <label for="subject">Subject</label>
              <input id="subject" name="subject" type="text" placeholder="Subject of your message" required>
            </div>

            <div>
              <label for="message">Message</label>
              <textarea id="message" name="message" placeholder="Write your message here..." required></textarea>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn-primary">Send message</button>
              <button type="button" class="btn-ghost" onclick="document.getElementById('contactForm').reset()">Reset</button>
            </div>

            <div id="formFeedback" style="color:var(--muted);font-size:.9rem;margin-top:.6rem" aria-live="polite"></div>
          </form>
        </div>

        <aside class="card contact-info" aria-labelledby="contact-info-title">
          <h3 id="contact-info-title" style="margin-bottom:.25rem">Contact information</h3>
          <ul class="info-list" aria-hidden="false">
            <li><span class="chip">📍</span><span>Benin City, Edo State, Nigeria</span></li>
            <li><span class="chip">✉️</span><span>info@homedonation.ng</span></li>
            <li><span class="chip">📞</span><span>+234 800 000 0000</span></li>
          </ul>

          <div style="margin-top:1rem">
            <h4 style="margin:.25rem 0;color:var(--accent)">Office hours</h4>
            <p style="color:var(--muted);margin:0">Mon — Fri: 09:00 — 17:00 WAT</p>
          </div>

          <div class="map" role="img" aria-label="Map placeholder">
            Map placeholder
          </div>

          <div style="margin-top:1rem;color:var(--muted);font-size:.95rem">
            <strong style="color:var(--white)">Follow us</strong>
            <div style="margin-top:.5rem;display:flex;gap:.5rem">
              <a href="#" style="color:var(--muted);text-decoration:none">Twitter</a>
              <a href="#" style="color:var(--muted);text-decoration:none">Facebook</a>
              <a href="#" style="color:var(--muted);text-decoration:none">Instagram</a>
            </div>
          </div>
        </aside>
      </div>

      <footer>
        <div>© <strong>Home Donation</strong> — Thank you for your kindness</div>
      </footer>
    </section>
  </main>

  <script>
    (function(){
      const form = document.getElementById('contactForm');
      const feedback = document.getElementById('formFeedback');

      form.addEventListener('submit', function(e){
        e.preventDefault();
        // Basic validity check
        if (!form.checkValidity()) {
          feedback.textContent = 'Please complete all required fields.';
          return;
        }

        // Simulate submission
        const name = form.name.value.trim();
        feedback.style.color = 'var(--muted)';
        feedback.textContent = 'Sending message...';

        setTimeout(() => {
          feedback.style.color = 'var(--accent-2)';
          feedback.textContent = `Thanks, ${name || 'friend'} — your message has been received. We'll reply soon.`;
          form.reset();
        }, 900);
      });
    })();
  </script>
</body>
</html>
