<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About Donation Page</title>
  <style>
    :root{
      --bg:#0f1724;
      --card:#0b1220;
      --muted:#9aa7b2;
      --accent:#7c3aed;
      --accent-2:#06b6d4;
      --white:#f8fafc;
      --radius:12px;
      --glass: rgba(255,255,255,0.03);
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
      background: linear-gradient(180deg, #071028 0%, #071a2a 60%);
      color:var(--white);
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      line-height:1.45;
    }
    .nav{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:1rem;
      padding:1rem 1.25rem;
      max-width:1100px;
      margin:0 auto;
    }
    .brand{
      display:flex;
      align-items:center;
      gap:.75rem;
      text-decoration:none;
      color:var(--white);
    }
    .logo{
      width:44px;
      height:44px;
      border-radius:10px;
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      display:inline-grid;
      place-items:center;
      font-weight:700;
      box-shadow:0 6px 18px rgba(124,58,237,0.18);
    }
    .brand h1{font-size:1rem;margin:0;font-weight:700;letter-spacing:0.2px}
    .nav-links{
      display:flex;
      gap:1rem;
      align-items:center;
    }
    .nav-links a{
      color:var(--muted);
      text-decoration:none;
      padding:.45rem .6rem;
      border-radius:8px;
      font-weight:600;
      font-size:.95rem;
    }
    .nav-links a:hover{color:var(--white); background:var(--glass)}
    .btn-donate{
      background:linear-gradient(90deg,var(--accent),var(--accent-2));
      color:var(--white);
      padding:.6rem .9rem;
      border-radius:10px;
      border:0;
      font-weight:700;
      cursor:pointer;
      box-shadow:0 8px 24px rgba(6,182,212,0.12);
    }
    .btn-donate:active{transform:translateY(1px)}
    .container{
      max-width:1100px;
      margin:2.25rem auto;
      padding:1.25rem;
    }
    .hero{
      display:grid;
      grid-template-columns:1fr 360px;
      gap:1.5rem;
      align-items:center;
    }
    .card{
      background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
      border-radius:var(--radius);
      padding:1.5rem;
      box-shadow:0 10px 30px rgba(2,6,23,0.6);
      border:1px solid rgba(255,255,255,0.03);
    }
    h2{margin:0 0 .5rem 0; font-size:1.6rem; color:var(--white)}
    p.lead{color:var(--muted); margin:0 0 1rem 0; font-size:1rem}
    .cta{
      display:flex;
      gap:.75rem;
      align-items:center;
      margin-top:1rem;
    }
    .secondary{
      background:transparent;
      color:var(--muted);
      border:1px solid rgba(255,255,255,0.04);
      padding:.55rem .8rem;
      border-radius:10px;
      cursor:pointer;
      font-weight:600;
    }
    .donation-panel{
      text-align:left;
    }
    .amount{
      display:flex;
      gap:.5rem;
      margin-top:.75rem;
    }
    .amount button{
      background:transparent;
      color:var(--white);
      border:1px solid rgba(255,255,255,0.06);
      padding:.6rem .8rem;
      border-radius:10px;
      cursor:pointer;
      font-weight:700;
    }
    .amount button.active{
      background:linear-gradient(90deg,var(--accent),var(--accent-2));
      box-shadow:0 8px 20px rgba(124,58,237,0.12);
      border:0;
    }
    footer{
      margin-top:2rem;
      padding:1.25rem;
      text-align:center;
      color:var(--muted);
      font-size:.9rem;
    }
    @media (max-width:880px){
      .hero{grid-template-columns:1fr; padding:0}
      .nav{padding:.75rem}
      .nav-links{display:none}
    }
  </style>
</head>
<body>
  <header class="nav" role="banner">
    <a class="brand" href="#" aria-label="Home">
      <div class="logo">HD</div>
      <div>
        <h1>Home Donation</h1>
        <div style="font-size:.78rem;color:var(--muted);margin-top:2px">Give with purpose</div>
      </div>
    </a>

    <nav class="nav-links" role="navigation" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <button class="btn-donate" aria-label="Donate now">Donate</button>
    </nav>
  </header>
  <main>
    <h1 style=  "color: green;">About Page.This is the page that tells you all we are about.</h1>
    <p style="color: violet;">This is the page that tells you all we are about.</p>

    
    <footer>
      <div>© <strong>Home Donation</strong> — Thank you for your kindness</div>
    </footer>
  </main>
  
</body>
</html>